# ==============================================================================
# .gitignore - QxuanStore Shoe E-Commerce
# Aturan keamanan untuk mencegah berkas sensitif & data privasi terunggah ke GitHub
# ==============================================================================

# 1. Berkas Bukti Pembayaran Customer (Privasi & PII Data Keuangan)
# Jangan pernah unggah bukti transfer/struk pelanggan ke publik repository
assets/uploads/bukti/*
!assets/uploads/bukti/.gitkeep

# 2. Berkas Kredensial & Lingkungan (Environment & Secret Keys)
.env
.env.*
*.env
credentials.json
service-account.json

# 3. Berkas Cadangan Basis Data (Database Dumps & Backups)
# Berisi data tabel user, password hash, dan transaksi nyata
*.sql
*.sql.gz
*.bak
*.dump

# 4. Berkas Log & Error Runtime
*.log
error_log
logs/

# 5. Berkas Sistem Operasi & Editor / IDE
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Direktori Sementara & Cache
tmp/
temp/
cache/
sessions/
node_modules/
vendor/

